# Autogenerated by CMake at build time.

config.buddy_obj_root = "@CMAKE_BINARY_DIR@"
config.llvm_tools_dir = "@LLVM_TOOLS_DIR@"
config.llvm_shlib_ext = "@LLVM_SHLIBEXT@"
config.python_executable = "@PYTHON_EXECUTABLE@"

# Optional knobs used by top-level tests config; keep defaults if not defined.
try:
    config.buddy_mlir_enable_python_packages = "@BUDDY_MLIR_ENABLE_PYTHON_PACKAGES@"
except Exception:
    pass

# Load the midend tests main config (no llvm_config dependency).
lit_config.load_config(config, "@PROJECT_SOURCE_DIR@/midend/test/lit.cfg.py")